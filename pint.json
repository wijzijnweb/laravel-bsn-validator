{
    "preset": "per",
    "rules": {
        "array_syntax": {
            "syntax": "short"
        },
        "binary_operator_spaces": {
            "operators": {
                "=>": "align_single_space_minimal",
                "=": "align_single_space_minimal"
            }
        },
        "declare_strict_types": true,
        "ordered_imports": {
            "imports_order": [
                "class",
                "function",
                "const"
            ],
            "sort_algorithm": "alpha"
        },
        "ordered_traits": true,
        "single_line_empty_body": true,
        "concat_space": {
            "spacing": "one"
        },
        "no_extra_blank_lines": {
            "tokens": [
                "curly_brace_block",
                "extra",
                "throw",
                "use"
            ]
        },
        "blank_line_before_statement": {
            "statements": [
                "break",
                "continue",
                "declare",
                "if",
                "return",
                "throw",
                "try"
            ]
        },
        "global_namespace_import": {
            "import_classes": true
        },
        "trailing_comma_in_multiline": {
            "elements": [
                "arguments",
                "arrays",
                "match",
                "parameters"
            ]
        }
    }
}
